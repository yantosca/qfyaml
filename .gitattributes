# qfyaml .gitattributes file
#
# Normalizes line endings for text source files and marks build-time
# artifacts as generated so they are handled consistently across
# platforms and collapsed by default in GitHub diffs/blame.
#
# For info on how .gitattributes rules work, see:
# https://git-scm.com/docs/gitattributes

# Default: normalize line endings to LF in the repo, let git decide
# checkout behavior based on the platform.
* text=auto eol=lf

# Source code
*.f      text
*.f90    text
*.F90    text
*.cmake  text
CMakeLists.txt text
Makefile*  text
*.sh     text eol=lf

# Config / data
*.yml    text
*.yaml   text
*.json   text

# Docs
*.md     text
*.rst    text
LICENSE.txt text

# Binary/opaque files: do not attempt line-ending or diff normalization
*.mod    -text binary
*.x      -text binary
*.o      -text binary
